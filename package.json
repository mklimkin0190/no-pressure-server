{
  "name": "no-pressure-server",
  "version": "1.0.0",
  "description": "Server for No Pressure",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "ts-node-dev --respawn src/app.ts",
    "build": "tsc",
    "migrate": "node-pg-migrate --migration-file-language ts",
    "migrate:up": "tsc && node-pg-migrate up --migrations-dir dist/migrations",
    "migrate:down": "tsc && node-pg-migrate down --migrations-dir dist/migrations"
  },
  "dependencies": {
    "@types/pg": "^8.20.0",
    "dotenv": "^17.4.0",
    "fastify": "^5.8.4",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.1",
    "node-pg-migrate": "^8.0.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.2"
  },
  "node-pg-migrate": {
    "tsconfig": "tsconfig.json"
  }
}
